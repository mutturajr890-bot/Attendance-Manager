# Supabase project settings — client-safe (anon/publishable) keys.
# Get these from your Supabase project: Settings -> API.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"

# Same values, exposed to the Vite client bundle.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-only. NEVER prefix this with VITE_ or it will be bundled into
# client code. Used by src/integrations/supabase/client.server.ts to
# bypass Row Level Security for trusted server-side/admin operations.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-only. Shared secret used to authenticate scheduled/cron requests
# (see src/integrations/supabase/cron-auth.ts). Rotate by setting
# CRON_SECRET_PREVIOUS to the old value while switching CRON_SECRET.
CRON_SECRET="generate-a-long-random-string"
CRON_SECRET_PREVIOUS=""
